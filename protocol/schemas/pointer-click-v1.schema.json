{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:komado:pointer-click:v1",
  "title": "komado pointer click v1",
  "description": "Sequence and revision are limited to 9007199254740991 by the implementations.",
  "type": "array",
  "prefixItems": [
    { "const": "1" },
    { "const": "pointer.click" },
    { "type": "string", "pattern": "^[1-9][0-9]{0,15}$", "maxLength": 16, "not": { "pattern": "[^0-9]" } },
    { "type": "string", "pattern": "^[1-9][0-9]{0,15}$", "maxLength": 16, "not": { "pattern": "[^0-9]" } },
    { "type": "string", "pattern": "^(0|[1-9][0-9]{0,5}|1000000)$", "maxLength": 7, "not": { "pattern": "[^0-9]" } },
    { "type": "string", "pattern": "^(0|[1-9][0-9]{0,5}|1000000)$", "maxLength": 7, "not": { "pattern": "[^0-9]" } },
    { "enum": ["left", "right", "middle"] }
  ],
  "minItems": 7,
  "maxItems": 7,
  "items": false
}
