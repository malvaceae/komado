{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:komado:keyboard-text-posted:v1",
  "description": "Confirms event posting only. Sequence is limited to 9007199254740991 by implementations.",
  "type": "array",
  "prefixItems": [
    { "const": "1" },
    { "const": "keyboard.text.posted" },
    { "type": "string", "pattern": "^[1-9][0-9]{0,15}$", "not": { "pattern": "[^0-9]" } }
  ],
  "minItems": 3,
  "maxItems": 3,
  "items": false
}
