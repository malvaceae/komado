    },
    {
      "type": "array",
      "prefixItems": [
        { "const": "1" }, { "const": "window.list" },
        { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})$", "not": { "pattern": "[^0-9]" } }
      ],
      "minItems": 3, "maxItems": 3, "items": false
    },
    {
      "type": "array",
      "description": "Next offset, followed by up to 32 groups of window ID, width, height, application name, title, on-screen status (0 or 1), and application ID. Ranges, byte sizes, group count and unique IDs are checked by implementations.",
      "prefixItems": [
        { "const": "1" }, { "const": "window.listed" },
        { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})$", "not": { "pattern": "[^0-9]" } }
      ],
      "items": { "type": "string", "minLength": 1, "maxLength": 96 },
      "minItems": 3, "maxItems": 227
    },
    {
      "type": "array",
      "prefixItems": [
        { "const": "1" }, { "const": "display.control" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,9}$", "not": { "pattern": "[^0-9]" } }
      ],
      "minItems": 3, "maxItems": 3, "items": false
    },
    {
      "type": "array",
      "prefixItems": [
        { "const": "1" }, { "const": "window.control" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,9}$", "not": { "pattern": "[^0-9]" } },
        { "type": "string", "pattern": "^[1-9][0-9]{0,4}$", "not": { "pattern": "[^0-9]" } },
        { "type": "string", "pattern": "^[1-9][0-9]{0,4}$", "not": { "pattern": "[^0-9]" } }
      ],
      "minItems": 3, "maxItems": 5, "not": { "minItems": 4, "maxItems": 4 }, "items": false
    },
    {
      "type": "array",
      "prefixItems": [
        { "const": "1" }, { "const": "window.start" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,9}$", "not": { "pattern": "[^0-9]" } }
      ],
      "minItems": 3, "maxItems": 3, "items": false
    },
    {
      "type": "array",
      "prefixItems": [
        { "const": "1" }, { "const": "window.action" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,9}$", "not": { "pattern": "[^0-9]" } },
        { "enum": ["minimize", "restore", "close"] }
      ],
      "minItems": 4, "maxItems": 4, "items": false
    },
    {
      "type": "array",
      "prefixItems": [
        { "const": "1" }, { "const": "window.action.result" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,9}$", "not": { "pattern": "[^0-9]" } },
        { "enum": ["0", "1"] }
      ],
      "minItems": 4, "maxItems": 4, "items": false
    },
    {
      "type": "array",
      "prefixItems": [
        {
          "const": "1"
        },
        {
          "const": "offer"
        },
        {
          "type": "string",
          "minLength": 5,
          "maxLength": 12288,
          "pattern": "^v=0\\r\\n",
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]"
          }
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    {
      "type": "array",
      "prefixItems": [
        {
          "const": "1"
        },
        {
          "const": "answer"
        },
        {
          "type": "string",
          "minLength": 5,
          "maxLength": 12288,
          "pattern": "^v=0\\r\\n",
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]"
          }
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    }
