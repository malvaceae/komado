      "minItems": 3, "maxItems": 3, "items": false
    },
    {
      "type": "array",
      "prefixItems": [{ "const": "1" }, { "enum": ["window.watch", "window.watching", "window.changed", "window.watch.stop", "window.watch.stopped"] }],
