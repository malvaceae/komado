    {
      "type": "array",
      "prefixItems": [{ "const": "1" }, { "const": "resume.check" }],
      "minItems": 2, "maxItems": 2, "items": false
    },
    {
      "type": "array",
      "prefixItems": [{ "const": "1" }, { "const": "resume.allowed" }],
      "minItems": 2, "maxItems": 2, "items": false
    },
