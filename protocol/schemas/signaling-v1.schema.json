    {
      "type": "array",
      "prefixItems": [{ "const": "1" }, { "enum": ["application.list", "launch.list"] },
        { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})$", "not": { "pattern": "[^0-9]" } }],
      "minItems": 3, "maxItems": 3, "items": false
    },
    {
      "type": "array",
      "description": "Next offset and up to 32 pairs of application ID and name. Running applications use process IDs; launch candidates use connection-local IDs. Ranges, grouping, UTF-8 lengths and unique IDs are checked by implementations.",
