          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 4,
          "maxLength": 96,
          "not": {
            "pattern": "[^A-Za-z0-9+/=]"
          }
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    {
