            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 44,
          "maxLength": 44,
          "not": {
            "pattern": "[^A-Za-z0-9+/=]"
          }
        },
        {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 4,
          "maxLength": 172,
          "not": {
            "pattern": "[^A-Za-z0-9+/=]"
          }
