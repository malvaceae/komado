{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:komado:keyboard-text:v1",
  "title": "komado committed keyboard text v1",
  "description": "Sequence and revision are limited to 9007199254740991; text is limited to 512 UTF-8 bytes by the implementations.",
  "type": "array",
  "prefixItems": [
    { "const": "1" },
    { "enum": ["keyboard.text", "keyboard.text.checked"] },
    { "type": "string", "pattern": "^[1-9][0-9]{0,15}$", "maxLength": 16, "not": { "pattern": "[^0-9]" } },
    { "type": "string", "pattern": "^[1-9][0-9]{0,15}$", "maxLength": 16, "not": { "pattern": "[^0-9]" } },
    { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "[\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]" } }
  ],
  "minItems": 5,
  "maxItems": 5,
  "items": false
}
